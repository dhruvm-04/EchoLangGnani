# Copy this file to backend/.env and fill in your own credentials.
GNANI_API_KEY=
GNANI_STT_MODEL=prisma-v3.0
GNANI_TTS_MODEL=timbre-v3.0

# OpenAI-compatible base URL; the app appends /chat/completions.
ECHOLANG_LLM_BASE_URL=
ECHOLANG_LLM_MODEL=
ECHOLANG_LLM_API_KEY=

# Optional local configuration.
# ECHOLANG_DB_PATH=backend/data/echolang.sqlite3
# ECHOLANG_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# ECHOLANG_REQUIRE_APPROVAL=1
# ECHOLANG_ADMIN_KEY=replace-with-a-long-random-secret
